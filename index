        var desc = document.getElementById("modal-desc");

        // Lấy dữ liệu hoặc dùng dữ liệu mặc định
        var data = wikiData[locationName] || defaultData;

        title.innerText = "📍 " + locationName + " (Giai đoạn 1945-1950)";
        desc.innerText = data.desc;

        // Xử lý hình ảnh
        if (data.img) {
            img.src = data.img;
            img.style.display = "block";
        } else {
            img.style.display = "none";
        }

        modal.style.display = "block";
    }

    // --- HÀM ĐÓNG MODAL ---
